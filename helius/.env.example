# Only this helius/.env is loaded. The old root .env is not loaded.
DRY_RUN=true
# 默认不启用。实盘校准须另行显式设置DRY_RUN=false，并配置专用钱包。
LIVE_CALIBRATION=false
CALIBRATION_SIZE_SOL=0.05
CALIBRATION_MAX_BUYS=20
CALIBRATION_LOSS_LIMIT_SOL=0.1
# 校准模式默认data/calibration.json；若原.env指定了STATE_FILE，启用时明确改为此独立路径。
# 在模拟买入前拦截弱买盘、持续下跌、大砸单；保留后台观察。纸面开关；实盘校准强制应用相同六项检查，不受此开关关闭影响。
PAPER_PREBUY_FILTER=true
HELIUS_API_KEY=your-helius-api-key
# These are derived from the API key unless explicitly overridden:
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=...
HELIUS_SENDER_URL=http://slc-sender.helius-rpc.com/fast
WALLET_PRIVATE_KEY_BS58=

# Single large sell, no watchlist and no two-seller prerequisite.
MIN_SELL_SOL=8
MIN_PRICE_IMPACT_PCT=10
MAX_PRICE_IMPACT_PCT=30
MIN_POOL_QUOTE_SOL=30
POSITION_SIZE_SOL=1
MAX_CONCURRENT_POSITIONS=20
MAX_CANDIDATES_PER_MINUTE=6
COOLDOWN_MS=30000
MAX_SIGNAL_AGE_MS=2500

TAKE_PROFIT_PCT=20
STOP_LOSS_PCT=25
TRAILING_ACTIVATE_PCT=10
TRAILING_DRAWDOWN_PCT=3
MAX_HOLD_MS=1800000
BUY_SLIPPAGE_BPS=1000
SELL_SLIPPAGE_BPS=1500

# Two hours after confirmed sell. Check once per minute.
CLOSE_ACCOUNT_AFTER_MS=7200000
CLEANUP_INTERVAL_MS=60000

BLOCKHASH_REFRESH_MS=15000
POSITION_POLL_MS=15000
COMPUTE_UNIT_LIMIT=300000
PRIORITY_FEE_LAMPORTS=100000
SENDER_TIP_LAMPORTS=200000

# 0 means no stream cap. If exceeded, pause market subscription and new buys
# until next UTC day. Existing positions still have RPC exit monitoring.
MAX_STREAM_MB_PER_DAY=0
# Defaults: data/paper.json or data/live.json, relative to helius/.
# STATE_FILE=data/live.json

# Shadow learning: observes only, never filters or changes real orders.
SHADOW_ENABLED=true
# Paths are relative to helius/. No model is bundled; probability is null until trained.
SHADOW_DIRECTORY=data/shadow
# SHADOW_MODEL_FILE=data/models/rebound-60s.json
# Optional, independently validated observation models. Never gate orders.
# SHADOW_RISK_MODEL_FILE=data/models/loss-25.json
# SHADOW_RETURN_MODEL_FILE=data/models/net-return.json
# Fixed research exits share the baseline entry. Account-state recovery uses bounded RPC below.
SHADOW_EXIT_COMPARISONS=true
# Independent entry timing study; does not place orders or request additional quotes.
SHADOW_ENTRY_COMPARISONS=true
SHADOW_STATE_QUOTES=true
SHADOW_STATE_QUOTE_REQUESTS_PER_MINUTE=10
SHADOW_STATE_QUOTE_INTERVAL_MS=15000
SHADOW_MAX_ACTIVE=1000
SHADOW_MAX_ACTIVE_PER_POOL=100
SHADOW_MAX_POOLS=5000
SHADOW_MAX_HISTORY_EVENTS=100000
SHADOW_MAX_EVENTS_PER_POOL=2000
SHADOW_MIN_HISTORY_SWAPS=10
# Counterfactual assumptions, NOT actual transaction timing or SDK fee settings:
SHADOW_ENTRY_DELAY_MS=500
SHADOW_ENTRY_DEADLINE_MS=2500
SHADOW_EXIT_DELAY_MS=500
SHADOW_MAX_OBSERVATION_GAP_MS=10000
SHADOW_SWAP_FEE_BPS=100
SHADOW_SLIPPAGE_BPS=100
SHADOW_REBOUND_PCT=5

# Independent read-only dashboard. Use an SSH tunnel for remote access.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Required if binding a non-loopback address. Use HTTPS reverse proxy for public access.
# DASHBOARD_TOKEN=
# DASHBOARD_PUBLIC_ORIGIN=https://dashboard.example.com

# Candidate comparisons only; never gate live or paper orders
SHADOW_EXPERIMENT_MAX_SELL_SOL=40
SHADOW_EXPERIMENT_LOSS_COOLDOWN_MS=600000

# 60秒内曾跌25%的独立观察模型（不是平仓loss_25）；与SHADOW_MODEL_FILE的rebound_60s搭配
SHADOW_DRAWDOWN_MODEL_FILE=
